JWT_SECRET=dev-secret-change-me
# Include the public site origin in production, e.g. https://events.ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: overrides [database].url in config.ini. Leave unset to use config.ini,
# or unset both to fall back to local sqlite:///./events.db.
DATABASE_URL=
